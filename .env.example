# Copy this file to .env and replace every placeholder before deployment.
POSTGRES_DB=examguars
POSTGRES_USER=examguars
DATABASE_NAME=examguars
DATABASE_USER=examguars
EXAMGUARS_PUBLIC_BASE_URL=https://examguars.ten-truong.edu.vn
CORS_ALLOWED_ORIGINS=https://examguars.ten-truong.edu.vn
LOG_LEVEL=INFO

# These are host file paths. Keep secret material outside the repository.
EXAMGUARS_DATABASE_PASSWORD_HOST_FILE=/etc/examguars/secrets/postgres_password
EXAMGUARS_JWT_SECRET_HOST_FILE=/etc/examguars/secrets/jwt_secret
EXAMGUARS_SIGNING_KEY_HOST_FILE=/etc/examguars/secrets/signing_private_key.pem
EXAMGUARS_SIGNING_PASSPHRASE_HOST_FILE=/etc/examguars/secrets/signing_key_passphrase
EXAMGUARS_TRUSTED_PUBLIC_KEY_HOST_FILE=/etc/examguars/trusted_public_key.pem
EXAMGUARS_TLS_CERT_HOST_FILE=/etc/letsencrypt/live/examguars.ten-truong.edu.vn/fullchain.pem
EXAMGUARS_TLS_KEY_HOST_FILE=/etc/letsencrypt/live/examguars.ten-truong.edu.vn/privkey.pem
